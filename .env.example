# Angan environment variables — copy to .env and fill locally. Never commit real values.

# Supabase project (public anon key is safe for the client; service role is NOT)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay (test mode). Key secret lives only in Edge Function secrets, never here.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
