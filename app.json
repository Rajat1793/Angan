{
  "expo": {
    "name": "Angan",
    "slug": "angan",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "angan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FCFDF3"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.angan.mobile"
    },
    "android": {
      "package": "app.angan.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FCFDF3"
      },
      "permissions": ["CAMERA", "INTERNET"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-notifications",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": ""
      }
    }
  }
}
